{
  "id": "belegflowErinner3",
  "name": "Belegflow 3: Erinnerungen am Morgen",
  "active": false,
  "nodes": [
    {
      "id": "5f2d451a-ef98-53b5-898c-ed72c1e49ec7",
      "name": "Jetzt ausführen",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "a5284120-302a-5cb4-9e1c-5b9db114e176",
      "name": "Werktags um 8",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "7597210a-3436-5eb9-a9c3-414817d86615",
      "name": "Einstellungen",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "url",
              "name": "url",
              "type": "string",
              "value": "http://localhost:8000"
            },
            {
              "id": "mandant",
              "name": "mandant",
              "type": "string",
              "value": "1"
            },
            {
              "id": "absender",
              "name": "absender",
              "type": "string",
              "value": "belegflow@firma.example"
            },
            {
              "id": "buchhaltung",
              "name": "buchhaltung",
              "type": "string",
              "value": "buchhaltung@firma.example"
            }
          ]
        },
        "options": {
          "stripBinary": false
        }
      }
    },
    {
      "id": "c841a0c5-6968-5b5b-a804-dce5539d29b4",
      "name": "Fälliges holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $('Einstellungen').first().json.url }}/api/m/{{ $('Einstellungen').first().json.mandant }}/schnittstelle/erinnerungen",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bfSchnittst00001",
          "name": "Belegflow Schnittstelle"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "990030d0-d7e2-529a-a3dd-b67cbcfbfc47",
      "name": "Gibt es etwas",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.texte && $json.texte.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7a2ef1a1-8f92-5e83-a132-13eea2d6e736",
      "name": "Person erinnern",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        860,
        0
      ],
      "parameters": {
        "fromEmail": "={{ $('Einstellungen').first().json.absender }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=Belegflow: {{ $json.texte.length === 1 ? '1 Punkt wartet' : $json.texte.length + ' Punkte warten' }} auf dich",
        "emailFormat": "text",
        "text": "=Guten Morgen {{ $json.name }},\n\n{{ $json.texte.map(t => '- ' + t).join('\\n') }}\n\n{{ $('Einstellungen').first().json.url }}/#/{{ $('Einstellungen').first().json.mandant }}/uebersicht",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "bfSmtp0000000001",
          "name": "Belegflow SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Werktags um 8": {
      "main": [
        [
          {
            "node": "Einstellungen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Jetzt ausführen": {
      "main": [
        [
          {
            "node": "Einstellungen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Einstellungen": {
      "main": [
        [
          {
            "node": "Fälliges holen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fälliges holen": {
      "main": [
        [
          {
            "node": "Gibt es etwas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gibt es etwas": {
      "main": [
        [
          {
            "node": "Person erinnern",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Vienna"
  }
}
