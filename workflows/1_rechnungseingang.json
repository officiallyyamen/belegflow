    {
      "id": "659870e7-cfdf-5d0e-9cce-91b16831cd1f",
      "name": "Anhänge trennen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const erlaubt = /\\.(pdf|png|jpe?g|xml)$/i;\nconst ergebnis = [];\nfor (const [nummer, item] of $input.all().entries()) {\n  const mail = item.json;\n  const kopf = {\n    kennung: String(mail.messageId ?? mail.headers?.['message-id'] ?? '').slice(0, 300),\n    absender: String(mail.from?.text ?? mail.from ?? '').slice(0, 300),\n    betreff: String(mail.subject ?? '').slice(0, 500),\n    inhalt: String(mail.text ?? mail.textPlain ?? '').slice(0, 20000),\n    url: mail.url, mandant: mail.mandant, absender_mail: mail.absender, buchhaltung: mail.buchhaltung,\n  };\n  const dateien = Object.values(item.binary ?? {}).filter((d) => erlaubt.test(d.fileName ?? ''));\n  for (const datei of dateien) {\n    ergebnis.push({ json: { ...kopf, dateiname: datei.fileName, hat_datei: true }, binary: { datei }, pairedItem: nummer });\n  }\n  if (!dateien.length) ergebnis.push({ json: { ...kopf, dateiname: '', hat_datei: false }, pairedItem: nummer });\n}\nreturn ergebnis;"
      }
    },
